# Application
NODE_ENV=development
PORT=3000

# Database (OpenShift: use port-forward or in-cluster service)
DATABASE_URL=postgresql://stm_dev:stm_dev_password@localhost:5432/slack_thread_manager

# Keycloak (Story 1.3)
KEYCLOAK_REALM_URL=https://stm-keycloak-slack-thread-manager.apps.ocp4.shebi.eu/realms/slack-thread-manager
KEYCLOAK_CLIENT_ID=slack-thread-manager-web

# Frontend Keycloak (VITE_ prefix = exposed to browser — NO secrets here)
VITE_KEYCLOAK_URL=https://stm-keycloak-slack-thread-manager.apps.ocp4.shebi.eu
VITE_KEYCLOAK_REALM=slack-thread-manager
VITE_KEYCLOAK_CLIENT_ID=slack-thread-manager-web

# Slack (configured in Story 2.1)
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=

# Ingestion schedule (cron expression, default: every 4 hours)
# INGESTION_CRON_SCHEDULE=0 */4 * * *

# LLM (configured in Story 3.1)
CPU_MODEL_URL=http://stm-ollama.slack-thread-manager.svc.cluster.local:11434
CPU_MODEL_NAME=phi3:mini
CPU_EMBED_MODEL_NAME=nomic-embed-text
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash
LLM_TIMEOUT_MS=60000
