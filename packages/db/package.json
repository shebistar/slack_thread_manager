{
  "name": "@slack-thread-manager/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "push": "dotenv -e ../../.env -- drizzle-kit push",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "import-text": "dotenv -e ../../.env -- tsx src/import-text.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "pg": "^8.13.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
